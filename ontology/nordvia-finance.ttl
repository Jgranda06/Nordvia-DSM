#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( nvf:CustomerCreditMemo
                nvf:CustomerPayment
                nvf:GLDocument
                nvf:Invoice
                nvf:OutgoingPayment
                nvf:ReversalDocument
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( nvf:DomesticCustomer
                nvf:ForeignCustomer
                nvf:OneTimeCustomer
                nvf:UnregisteredCustomer
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( nvf:Administration
                        nvf:Sales
                        nvf:Service
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( nvf:CrossRate
                        nvf:DirectRate
                        nvf:InverseRate
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( nvf:CustomerAccountType
                        nvf:GLAccountType
                        nvf:PayeeAccountType
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( nvf:NotYetDue
                        nvf:Overdue1To30
                        nvf:Overdue31To60
                        nvf:Overdue61To90
                        nvf:OverdueOver90
                      )
] .


