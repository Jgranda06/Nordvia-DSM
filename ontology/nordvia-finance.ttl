nvf:InputTaxCode rdf:type owl:Class ;
                 rdfs:subClassOf nvf:TaxCode ;
                 owl:disjointWith nvf:OutputTaxCode ;
                 rdfs:label "Input Tax Code"@en ;
                 skos:definition "Tax paid to vendors on purchases."@en .


###  https://nordvia.com/ontology/finance#Invoice
nvf:Invoice rdf:type owl:Class ;
            rdfs:subClassOf nvf:AccountingDocument ,
                            schema:Invoice ;
            rdfs:label "Invoice"@en ;
            skos:definition "A document that records an amount owed for goods or services."@en .


###  https://nordvia.com/ontology/finance#LineItem
nvf:LineItem rdf:type owl:Class ;
             rdfs:label "Line Item"@en ;
             skos:definition "One debit or credit posting inside an accounting document."@en ;
             skos:scopeNote "A customer or payee line with no clearing document is an open item. Openness is the absence of a link, so it is asked for in the query rather than stated as a class."@en ;
             nvf:sourceField "BSEG" .


###  https://nordvia.com/ontology/finance#MonthlyExchangeRate
nvf:MonthlyExchangeRate rdf:type owl:Class ;
                        rdfs:label "Monthly Exchange Rate"@en ;
                        rdfs:seeAlso fibo-cur:ExchangeRate ;
                        skos:definition "The rate used to convert amounts from a local currency into euros for one fiscal period."@en ;
                        skos:scopeNote "The source has no rate table. Each rate is rebuilt from the exchange rates on the foreign-currency documents posted in the period, and records the method used so the conversion can be checked."@en .


###  https://nordvia.com/ontology/finance#OneTimeCustomer
nvf:OneTimeCustomer rdf:type owl:Class ;
                    rdfs:subClassOf nvf:Customer ;
                    rdfs:label "One-Time Customer"@en ;
                    skos:definition "A collective account used for occasional buyers who do not get a master record of their own."@en ;
                    skos:scopeNote "Account group CPD. Balances on these accounts cannot be attributed to an individual customer."@en ;
                    nvf:sourceField "KNA1.KTOKD" .


###  https://nordvia.com/ontology/finance#OpeningBalanceDocument
nvf:OpeningBalanceDocument rdf:type owl:Class ;
                           rdfs:subClassOf nvf:GLDocument ;
                           rdfs:label "Opening Balance Document"@en ;
                           skos:definition "The document that brought the balances carried forward from the previous year into the books of a company."@en ;
                           skos:scopeNote "One per company, posted on the first day of the year by the migration user. It holds balances, not activity of the year, so it counts for balance sheet figures and is left out when measuring what happened in the year."@en .


###  https://nordvia.com/ontology/finance#OutgoingPayment
nvf:OutgoingPayment rdf:type owl:Class ;
                    rdfs:subClassOf nvf:AccountingDocument ;
                    rdfs:label "Outgoing Payment"@en ;
                    skos:definition "Money paid out to a payee."@en ;
                    skos:scopeNote "Document type KZ"@en .


###  https://nordvia.com/ontology/finance#OutputTaxCode
nvf:OutputTaxCode rdf:type owl:Class ;
                  rdfs:subClassOf nvf:TaxCode ;
                  rdfs:label "Output Tax Code"@en ;
                  skos:definition "Tax charged to customers on sales."@en .


###  https://nordvia.com/ontology/finance#PayableInvoice
nvf:PayableInvoice rdf:type owl:Class ;
                   rdfs:subClassOf nvf:Invoice ;
                   rdfs:label "Payable Invoice"@en ;
                   skos:definition "A document recording an amount Nordvia owes to a payee: an invoice from a vendor or an expense claim from an employee."@en ;
                   skos:scopeNote "Document type KR"@en .


###  https://nordvia.com/ontology/finance#PayablesAccount
nvf:PayablesAccount rdf:type owl:Class ;
                    rdfs:subClassOf nvf:ReconciliationAccount ;
