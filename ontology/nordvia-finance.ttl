###  https://nordvia.com/ontology/finance#Payee
nvf:Payee rdf:type owl:Class ;
          rdfs:subClassOf nvf:BusinessPartner ;
          rdfs:label "Payee"@en ;
          rdfs:seeAlso fibo-psch:Payee ;
          skos:definition "A party Nordvia owes or pays money to. It is either a vendor or an employee."@en ;
          skos:scopeNote "SAP keeps all payees in what it calls the vendor master, which is why employees appear there next to real vendors."@en ;
          nvf:sourceField "LFA1" .


###  https://nordvia.com/ontology/finance#PaymentTerms
nvf:PaymentTerms rdf:type owl:Class ;
                 rdfs:subClassOf skos:Concept ;
                 rdfs:label "Payment Terms"@en ;
