###  https://nordvia.com/ontology/finance#ReconciliationAccount
nvf:ReconciliationAccount rdf:type owl:Class ;
                          rdfs:subClassOf nvf:CompanyAccount ;
                          rdfs:label "Reconciliation Account"@en ;
                          skos:definition "A company account that mirrors a subledger in the general ledger. It is never posted to directly."@en ;
                          nvf:sourceField "SKB1.MITKZ" .


###  https://nordvia.com/ontology/finance#ReversalDocument
nvf:ReversalDocument rdf:type owl:Class ;
                     rdfs:subClassOf nvf:AccountingDocument ;
                     rdfs:label "Reversal Document"@en ;
                     skos:definition "A document posted to cancel an earlier one by repeating its lines with the opposite sign."@en ;
                     skos:scopeNote "Document type AB"@en .


###  https://nordvia.com/ontology/finance#ReversedDocument
nvf:ReversedDocument rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( nvf:AccountingDocument
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty nvf:reversedBy ;
                                                                  owl:someValuesFrom nvf:ReversalDocument
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:label "Reversed Document"@en ;
                     skos:definition "A document that has been cancelled by a reversal. It stays in the books but nets to zero with its reversal."@en .


###  https://nordvia.com/ontology/finance#TaxCode
nvf:TaxCode rdf:type owl:Class ;
            rdfs:subClassOf skos:Concept ;
