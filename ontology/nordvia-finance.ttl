            skos:definition "The VAT treatment applied to a line."@en ;
            nvf:sourceField "BSEG.MWSKZ" .


###  https://nordvia.com/ontology/finance#UnregisteredCustomer
nvf:UnregisteredCustomer rdf:type owl:Class ;
                         rdfs:subClassOf nvf:Customer ;
                         rdfs:label "Unregistered Customer"@en ;
                         skos:definition "A customer number that appears on postings but has no record in the customer master."@en ;
                         skos:scopeNote "Created from the line items so that its receivables are not lost. Only the customer number is known: no name, address, account group or payment terms."@en ;
                         nvf:sourceField "BSEG.KUNNR" .


