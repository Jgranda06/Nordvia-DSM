###  https://nordvia.com/ontology/finance#ProfitAndLossAccount
nvf:ProfitAndLossAccount rdf:type owl:Class ;
                         rdfs:subClassOf nvf:GLAccount ;
                         rdfs:label "Profit and Loss Account"@en ;
                         skos:definition "A G/L account that collects revenue or expense for the period."@en ;
                         skos:scopeNote "The extract has no field separating revenue from expense accounts. Net result is the sum of credits minus debits over these accounts."@en ;
                         nvf:sourceField "SKA1.GVTYP" .


###  https://nordvia.com/ontology/finance#RateDerivationMethod
nvf:RateDerivationMethod rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( nvf:CrossRate
                                                           nvf:DirectRate
                                                           nvf:InverseRate
                                                         )
                                             ] ;
                         rdfs:subClassOf skos:Concept ;
                         rdfs:label "Rate Derivation Method"@en ;
                         skos:definition "A way of obtaining a monthly exchange rate from the documents available."@en .


