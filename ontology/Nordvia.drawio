<mxfile host="app.diagrams.net" pages="3">
  <diagram name="Conceptual schema" id="p0">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p0x0" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" value="&lt;b style=&quot;font-size:20px&quot;&gt;Nordvia finance ontology - conceptual schema&lt;/b&gt;&lt;br&gt;nvf: &amp;lt;https://nordvia.com/ontology/finance#&amp;gt;" vertex="1"><mxGeometry x="100" y="60" width="700" height="60" as="geometry" /></mxCell>
        <mxCell id="p0x1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;Ellipse: class. Rectangle: datatype of a literal.&lt;br&gt;Hollow arrow: rdfs:subClassOf. Dashed hollow arrow: subclass that follows from an owl:equivalentClass definition.&lt;br&gt;Arrow with a label: property, from its domain to its range (or, for reused properties with no declared domain, from the classes that carry it in the graph).&lt;br&gt;Dotted arrow to a dashed ellipse: rdfs:seeAlso to the matching FIBO / OMG Commons class.&lt;br&gt;skos:Concept is drawn several times to keep the lines short; it is one class." vertex="1"><mxGeometry x="100" y="130" width="620" height="150" as="geometry" /></mxCell>
        <mxCell id="p0x2" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;Not drawn, to keep it readable&lt;/b&gt;&lt;br&gt;rdfs:label, skos:prefLabel, skos:altLabel, skos:notation and skos:definition, which every class and code carries.&lt;br&gt;nvf:lineItemOf is a sub-property of dcterms:isPartOf; the four currency properties are sub-properties of fibo-cur:hasCurrency.&lt;br&gt;nvf:AccountType, nvf:DebitCreditIndicator, nvf:CostCenterCategory, nvf:DebtAgeBucket and nvf:RateDerivationMethod are closed lists (owl:oneOf); their members are on the page &quot;Usage schema&quot;." vertex="1"><mxGeometry x="100" y="300" width="620" height="150" as="geometry" /></mxCell>
